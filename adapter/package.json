    "src",
    "contrib",
    "ext",
    "react",
    "vue",
    "types",
    "dist-cjs",
    "release",
    "dist",
    "vendor-tools",
    "repl"
  ],
  "scripts": {
    "build:bridge": "../scripts/build-bridge.sh",
    "build:cjs": "node scripts/build-cjs.mjs",
    "test": "node test/smoke.mjs && node test/persist.mjs && node test/worker.mjs && node test/socket.mjs && node test/pg-compat.mjs && node test/sync-apply.mjs && node test/sync-provider.mjs && node test/extensions.mjs && node test/ext-packages.mjs && node test/tools.mjs && node test/diff.mjs && node test/browser/run.mjs && node test/browser/run.mjs /test/browser/frameworks.html && npm run -s build:test:repl && node test/browser/run-repl.mjs",
    "build:test:repl": "esbuild test/browser/repl-src.mjs --bundle --format=esm --outfile=test/repl-app.mjs '--external:./nodefs.js' '--external:fs' '--external:fs/promises' '--external:zlib' '--external:util' '--external:worker_threads' '--external:stream' '--external:stream/promises' '--external:path' '--external:net' '--external:events' '--external:url' '--external:module'"
  },
